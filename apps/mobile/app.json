{
  "expo": {
    "name": "高考副驾驶",
    "slug": "gaokao-copilot",
    "scheme": "gaokao",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gaokao.copilot",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于自动获取当前位置并显示当地天气",
        "NSMicrophoneUsageDescription": "用于录制错题语音反思",
        "NSCameraUsageDescription": "用于拍摄错题图片",
        "NSPhotoLibraryUsageDescription": "用于从相册选择错题图片"
      }
    },
    "android": {
      "package": "com.gaokao.copilot",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "用于自动获取当前位置并显示当地天气" }],
      ["expo-background-fetch"],
      ["expo-notifications", { "mode": "expo" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
