# Supabase 配置（来自 Supabase 项目 Dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 后端服务密钥（仅服务端使用，勿暴露给客户端）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI / 外部 API
TAVILY_API_KEY=your-tavily-key
OPENWEATHER_API_KEY=your-openweather-key

# LLM 多供应商（OpenAI 兼容协议，按需配置其一即可；备课流水线与语义检索使用）
LLM_PROVIDER=deepseek            # deepseek | openai | moonshot | glm
LLM_MODEL=                       # 可选，留空用该供应商默认模型
EMBEDDING_PROVIDER=openai        # openai | glm（向量维度固定 1536）
EMBEDDING_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=

# 备课流水线（Vercel Cron 触发）
CRON_SECRET=                     # Vercel 自动以 Bearer 头携带
OWNER_USER_ID=                   # 单用户应用：数据归属的 auth.users UUID

# 知识工坊：Obsidian 笔记仓库（GITHUB_REPO 格式 owner/repo；私有仓库需 GITHUB_TOKEN，仅服务端使用）
GITHUB_REPO=your-name/your-obsidian-vault
GITHUB_BRANCH=main
GITHUB_TOKEN=
